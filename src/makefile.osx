# Mac OS X makefile for 1337
# Originally by Laszlo Hanyecz (solar@heliacal.net)

# Builds with Apple's Clang against Homebrew packages, on Apple Silicon or Intel:
#   brew install boost openssl@3 berkeley-db@5 miniupnpc
#   make -f makefile.osx            (links Homebrew's shared libraries)
#   make -f makefile.osx STATIC=1   (links their static libraries, so the
#                                    binary runs on Macs without Homebrew)
# Paths can be overridden: BREW_PREFIX, BOOST_PREFIX, OPENSSL_PREFIX,
# BDB_PREFIX, MINIUPNPC_PREFIX.

CXX ?= clang++
CC ?= clang
ifeq ($(CXX),g++)
    CXX = clang++
endif
ifeq ($(CC),cc)
    CC = clang
endif

BREW_PREFIX ?= $(shell brew --prefix 2>/dev/null || echo /opt/homebrew)
BOOST_PREFIX ?= $(shell brew --prefix boost 2>/dev/null || echo $(BREW_PREFIX)/opt/boost)
OPENSSL_PREFIX ?= $(shell brew --prefix openssl@3 2>/dev/null || echo $(BREW_PREFIX)/opt/openssl@3)
BDB_PREFIX ?= $(shell brew --prefix berkeley-db@5 2>/dev/null || echo $(BREW_PREFIX)/opt/berkeley-db@5)
MINIUPNPC_PREFIX ?= $(shell brew --prefix miniupnpc 2>/dev/null || echo $(BREW_PREFIX)/opt/miniupnpc)

INCLUDEPATHS= \
 -I"$(CURDIR)" \
 -I"$(CURDIR)"/obj \
 -I"$(BOOST_PREFIX)/include" \
 -I"$(OPENSSL_PREFIX)/include" \
 -I"$(BDB_PREFIX)/include" \
 -I"$(MINIUPNPC_PREFIX)/include"

LIBPATHS= \
 -L"$(BOOST_PREFIX)/lib" \
 -L"$(OPENSSL_PREFIX)/lib" \
 -L"$(BDB_PREFIX)/lib" \
 -L"$(MINIUPNPC_PREFIX)/lib"

USE_UPNP:=1
USE_IPV6:=1

# Homebrew's Boost names its libraries with or without -mt depending on the
# version; use whichever is there
BOOST_LIB_SUFFIX ?= $(if $(wildcard $(BOOST_PREFIX)/lib/libboost_thread-mt.*),-mt,)
# boost_system is header-only since Boost 1.69 and no longer shipped since 1.89
BOOST_SYSTEM_LIB = $(if $(wildcard $(BOOST_PREFIX)/lib/libboost_system$(BOOST_LIB_SUFFIX).*),boost_system$(BOOST_LIB_SUFFIX),)
BOOST_LIBS = $(BOOST_SYSTEM_LIB) boost_filesystem$(BOOST_LIB_SUFFIX) boost_program_options$(BOOST_LIB_SUFFIX) \
             boost_thread$(BOOST_LIB_SUFFIX) boost_chrono$(BOOST_LIB_SUFFIX)

LIBS= -dead_strip

ifdef STATIC
# Static libraries, for a binary that can be copied to other Macs
LIBS += \
 $(BDB_PREFIX)/lib/libdb_cxx.a \
 $(foreach l,$(BOOST_LIBS),$(BOOST_PREFIX)/lib/lib$(l).a) \
 $(OPENSSL_PREFIX)/lib/libssl.a \
 $(OPENSSL_PREFIX)/lib/libcrypto.a \
 -lz
else
LIBS += \
 -ldb_cxx \
 $(addprefix -l,$(BOOST_LIBS)) \
 -lssl \
 -lcrypto \
 -lz
endif

DEFS=-DMAC_OSX -DMSG_NOSIGNAL=0 -DBOOST_SPIRIT_THREADSAFE

# The oldest macOS version the binary runs on
MACOSX_DEPLOYMENT_TARGET ?= 11.0
export MACOSX_DEPLOYMENT_TARGET

CFLAGS = -O2 -g -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET)

# -Wno-deprecated-declarations: OpenSSL 3 marks the EC_KEY API deprecated
CFLAGS += -Wall -Wextra -Wformat -Wno-ignored-qualifiers -Wformat-security -Wno-unused-parameter \
    -Wno-deprecated-declarations -Wno-unused-function \
    $(DEBUGFLAGS) $(DEFS) $(INCLUDEPATHS)
xCXXFLAGS = -std=c++17 $(CFLAGS) $(CXXFLAGS)
xCFLAGS = $(CFLAGS)

OBJS= \
    obj/fugue.o \
    obj/hamsi.o \
    obj/groestl.o \
    obj/blake.o \
    obj/bmw.o \
    obj/skein.o \
    obj/keccak.o \
    obj/shavite.o \
    obj/jh.o \
    obj/luffa.o \
    obj/cubehash.o \
    obj/echo.o \
    obj/simd.o \
    obj/alert.o \
    obj/version.o \
    obj/checkpoints.o \
    obj/netbase.o \
    obj/addrman.o \
    obj/crypter.o \
    obj/key.o \
    obj/db.o \
    obj/init.o \
    obj/keystore.o \
    obj/main.o \
    obj/miner.o \
    obj/net.o \
    obj/protocol.o \
    obj/bitcoinrpc.o \
    obj/rpcdump.o \
    obj/rpcnet.o \
    obj/rpcmining.o \
    obj/rpcwallet.o \
    obj/rpcblockchain.o \
    obj/rpcrawtransaction.o \
    obj/script.o \
    obj/sync.o \
    obj/util.o \
    obj/wallet.o \
    obj/walletdb.o \
    obj/noui.o \
    obj/pbkdf2.o \
    obj/kernel.o \
    obj/scrypt.o \
    obj/zerocoin/Accumulator.o \
    obj/zerocoin/AccumulatorProofOfKnowledge.o \
    obj/zerocoin/Coin.o \
    obj/zerocoin/CoinSpend.o \
    obj/zerocoin/Commitment.o \
    obj/zerocoin/ParamGeneration.o \
    obj/zerocoin/Params.o \
    obj/zerocoin/SerialNumberSignatureOfKnowledge.o \
    obj/zerocoin/SpendMetaData.o \
    obj/zerocoin/ZeroTest.o

ifndef USE_UPNP
	override USE_UPNP = -
endif
ifneq (${USE_UPNP}, -)
	DEFS += -DUSE_UPNP=$(USE_UPNP)
ifdef STATIC
	LIBS += $(MINIUPNPC_PREFIX)/lib/libminiupnpc.a
else
	LIBS += -lminiupnpc
endif
endif

ifneq (${USE_IPV6}, -)
	DEFS += -DUSE_IPV6=$(USE_IPV6)
endif

all: 1337d

LIBS += $(CURDIR)/leveldb/libleveldb.a $(CURDIR)/leveldb/libmemenv.a
DEFS += $(addprefix -I,$(CURDIR)/leveldb/include)
DEFS += $(addprefix -I,$(CURDIR)/leveldb/helpers)
OBJS += obj/txdb-leveldb.o
leveldb/libleveldb.a:
	@echo "Building LevelDB ..."; cd leveldb; $(MAKE) CC="$(CC)" CXX="$(CXX)" OPT="-O2 -mmacosx-version-min=$(MACOSX_DEPLOYMENT_TARGET)" libleveldb.a libmemenv.a; cd ..
obj/txdb-leveldb.o: leveldb/libleveldb.a

# auto-generated dependencies:
-include obj/*.P

obj/build.h: FORCE
	/bin/sh ../share/genbuild.sh obj/build.h
version.cpp: obj/build.h
DEFS += -DHAVE_BUILD_INFO

obj/%.o: %.c
	$(CC) -c $(xCFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	  sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	      -e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	  rm -f $(@:%.o=%.d)

obj/%.o: %.cpp
	$(CXX) -c $(xCXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	  sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	      -e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	  rm -f $(@:%.o=%.d)

obj/zerocoin/%.o: zerocoin/%.cpp
	$(CXX) -c $(xCXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	  sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	      -e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	  rm -f $(@:%.o=%.d)

1337d: $(OBJS:obj/%=obj/%)
	$(CXX) $(xCXXFLAGS) -o $@ $(LIBPATHS) $^ $(LIBS)

clean:
	-rm -f 1337d
	-rm -f obj/*.o
	-rm -f obj/zerocoin/*.o
	-rm -f obj/*.P
	-rm -f obj/zerocoin/*.P
	-rm -f obj/build.h

FORCE:
