# Builds 1337d.exe with MinGW-w64, by default against MSYS2's MINGW64 packages:
#   pacman -S mingw-w64-x86_64-toolchain mingw-w64-x86_64-boost \
#             mingw-w64-x86_64-openssl mingw-w64-x86_64-miniupnpc mingw-w64-x86_64-zlib
# plus Berkeley DB 5.3 with its C++ library (MSYS2 only has 6.x), given with
# BDB_INCLUDE_PATH / BDB_LIB_PATH. Run from an MSYS2 MINGW64 shell:
#   make -f makefile.mingw BDB_INCLUDE_PATH=... BDB_LIB_PATH=...
# Everything is linked statically, so 1337d.exe needs no extra DLLs.

USE_UPNP:=1

MINGW_PREFIX ?= /mingw64
BOOST_INCLUDE_PATH ?= $(MINGW_PREFIX)/include
BOOST_LIB_PATH ?= $(MINGW_PREFIX)/lib
OPENSSL_INCLUDE_PATH ?= $(MINGW_PREFIX)/include
OPENSSL_LIB_PATH ?= $(MINGW_PREFIX)/lib
MINIUPNPC_INCLUDE_PATH ?= $(MINGW_PREFIX)/include
MINIUPNPC_LIB_PATH ?= $(MINGW_PREFIX)/lib
BOOST_LIB_SUFFIX ?= -mt

INCLUDEPATHS= $(addprefix -I,$(BOOST_INCLUDE_PATH) $(BDB_INCLUDE_PATH) $(OPENSSL_INCLUDE_PATH))
LIBPATHS= $(addprefix -L,$(BOOST_LIB_PATH) $(BDB_LIB_PATH) $(OPENSSL_LIB_PATH))

# boost_system is header-only since Boost 1.69 and no longer shipped since 1.89
BOOST_SYSTEM_LIB = $(if $(wildcard $(BOOST_LIB_PATH)/libboost_system$(BOOST_LIB_SUFFIX).a),-l boost_system$(BOOST_LIB_SUFFIX),)

LIBS= \
 $(BOOST_SYSTEM_LIB) \
 -l boost_filesystem$(BOOST_LIB_SUFFIX) \
 -l boost_program_options$(BOOST_LIB_SUFFIX) \
 -l boost_thread$(BOOST_LIB_SUFFIX) \
 -l boost_chrono$(BOOST_LIB_SUFFIX) \
 -l db_cxx \
 -l ssl \
 -l crypto \
 -l z

DEFS=-DWIN32 -D_WINDOWS -DBOOST_THREAD_USE_LIB -DBOOST_SPIRIT_THREADSAFE
DEBUGFLAGS=-g
# -Wno-deprecated-declarations: OpenSSL 3 marks the EC_KEY API deprecated
CFLAGS=-mthreads -O2 -Wall -Wextra -Wno-ignored-qualifiers -Wformat -Wformat-security -Wno-unused-parameter \
    -Wno-deprecated-declarations $(DEBUGFLAGS) $(DEFS) $(INCLUDEPATHS)
xCXXFLAGS=-std=c++17 $(CFLAGS)
LDFLAGS=-Wl,--dynamicbase -Wl,--nxcompat -static -static-libgcc -static-libstdc++

ifndef USE_UPNP
	override USE_UPNP = -
endif
ifneq (${USE_UPNP}, -)
 INCLUDEPATHS += $(addprefix -I,$(MINIUPNPC_INCLUDE_PATH))
 LIBPATHS += $(addprefix -L,$(MINIUPNPC_LIB_PATH))
 LIBS += -l miniupnpc -l iphlpapi
 DEFS += -DMINIUPNP_STATICLIB -DSTATICLIB -DUSE_UPNP=$(USE_UPNP)
endif

# crypt32 and bcrypt are needed by OpenSSL 3
LIBS += -l kernel32 -l user32 -l gdi32 -l comdlg32 -l winspool -l winmm -l shell32 -l comctl32 -l ole32 -l oleaut32 \
 -l uuid -l rpcrt4 -l advapi32 -l ws2_32 -l mswsock -l shlwapi -l crypt32 -l bcrypt

# TODO: make the mingw builds smarter about dependencies, like the linux/osx builds are
HEADERS = $(wildcard *.h)

OBJS= \
    obj/fugue.o \
    obj/hamsi.o \
    obj/groestl.o \
    obj/blake.o \
    obj/bmw.o \
    obj/skein.o \
    obj/keccak.o \
    obj/shavite.o \
    obj/jh.o \
    obj/luffa.o \
    obj/cubehash.o \
    obj/echo.o \
    obj/simd.o \
    obj/alert.o \
    obj/version.o \
    obj/checkpoints.o \
    obj/netbase.o \
    obj/addrman.o \
    obj/crypter.o \
    obj/key.o \
    obj/db.o \
    obj/init.o \
    obj/keystore.o \
    obj/main.o \
    obj/miner.o \
    obj/net.o \
    obj/protocol.o \
    obj/bitcoinrpc.o \
    obj/rpcdump.o \
    obj/rpcnet.o \
    obj/rpcmining.o \
    obj/rpcwallet.o \
    obj/rpcblockchain.o \
    obj/rpcrawtransaction.o \
    obj/script.o \
    obj/sync.o \
    obj/util.o \
    obj/wallet.o \
    obj/walletdb.o \
    obj/noui.o \
    obj/kernel.o \
    obj/pbkdf2.o \
    obj/scrypt.o \
    obj/zerocoin/Accumulator.o \
    obj/zerocoin/AccumulatorProofOfKnowledge.o \
    obj/zerocoin/Coin.o \
    obj/zerocoin/CoinSpend.o \
    obj/zerocoin/Commitment.o \
    obj/zerocoin/ParamGeneration.o \
    obj/zerocoin/Params.o \
    obj/zerocoin/SerialNumberSignatureOfKnowledge.o \
    obj/zerocoin/SpendMetaData.o \
    obj/zerocoin/ZeroTest.o

all: 1337d.exe

# LevelDB first: it uses Windows libraries listed after it (static link order)
LIBS := $(CURDIR)/leveldb/libleveldb.a $(CURDIR)/leveldb/libmemenv.a $(LIBS)
DEFS += $(addprefix -I,$(CURDIR)/leveldb/include)
DEFS += $(addprefix -I,$(CURDIR)/leveldb/helpers)
OBJS += obj/txdb-leveldb.o
leveldb/libleveldb.a:
	cd leveldb && $(MAKE) TARGET_OS=NATIVE_WINDOWS CC="$(CC)" CXX="$(CXX)" libleveldb.a libmemenv.a
obj/txdb-leveldb.o: leveldb/libleveldb.a

obj/%.o: %.cpp $(HEADERS)
	$(CXX) -c $(xCXXFLAGS) -o $@ $<

# The X11 hash functions are plain C
obj/%.o: %.c
	$(CC) -c $(CFLAGS) -o $@ $<

obj/zerocoin/%.o: zerocoin/%.cpp
	$(CXX) -c $(xCXXFLAGS) -o $@ $<

1337d.exe: $(OBJS:obj/%=obj/%)
	$(CXX) $(xCXXFLAGS) $(LDFLAGS) -o $@ $(LIBPATHS) $^ $(LIBS)

clean:
	-rm -f 1337d.exe
	-rm -f obj/*.o obj/zerocoin/*.o
	
FORCE:
